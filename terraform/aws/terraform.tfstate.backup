          "schema_version": 0,
          "attributes": {
            "id": "650097720",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::649671357648:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/173943B07FF6115D96A7D317DE570870\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/173943B07FF6115D96A7D317DE570870:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.us-east-1.amazonaws.com/id/173943B07FF6115D96A7D317DE570870:sub\": \"system:serviceaccount:kube-system:ebs-csi-controller-sa\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::649671357648:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/173943B07FF6115D96A7D317DE570870\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.us-east-1.amazonaws.com/id/173943B07FF6115D96A7D317DE570870:aud\":\"sts.amazonaws.com\",\"oidc.eks.us-east-1.amazonaws.com/id/173943B07FF6115D96A7D317DE570870:sub\":\"system:serviceaccount:kube-system:ebs-csi-controller-sa\"}}}]}",
